# Large or derived data: never commit
data/genomes/
data/amrfinder_db/
data/metadata/*.txt
data/metadata/*.tsv
data/features/*
!data/features/.gitkeep
results/
.snakemake/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# OS
.DS_Store

# The selected genome list is small and defines the dataset: commit it
!data/metadata/selected_genomes.tsv
!data/metadata/genome_ids.txt

# Run logs and per-genome tool output
logs/
reports/*.log
!data/metadata/selected_500.tsv
!data/metadata/genome_ids_500.txt
